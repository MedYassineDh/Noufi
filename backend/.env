# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/noufi-game

# JWT Secret
JWT_SECRET=noufi-super-secret-jwt-key-2024-change-in-production-min-32-characters
JWT_EXPIRE=7d

# Security
BCRYPT_ROUNDS=10

# Game Configuration
DEFAULT_STARTING_BALANCE=1000
BOT_WIN_RATE=0.65
MATCHMAKING_TIMEOUT=20000

# CORS
FRONTEND_URL=http://localhost:8080
